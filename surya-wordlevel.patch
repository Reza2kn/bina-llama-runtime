+    def set_vocab(self):
+        tokenizer_path = self.dir_model / "tokenizer.json"
+        data = json.loads(tokenizer_path.read_text())
+        if data["model"]["type"] != "WordLevel":
+            return super().set_vocab()
+        assert data["pre_tokenizer"] == {"type": "Split", "pattern": {"Regex": "."}, "behavior": "Isolated", "invert": False}
+        assert data["normalizer"] is None and data["decoder"]["type"] == "Fuse"
+        vocab = data["model"]["vocab"]
+        tokens = [""] * len(vocab)
+        types = [gguf.TokenType.NORMAL] * len(vocab)
+        for token, idx in vocab.items(): tokens[idx] = token
+        for added in data["added_tokens"]:
+            assert not added["lstrip"] and not added["rstrip"] and not added["single_word"]
+            types[added["id"]] = gguf.TokenType.CONTROL if added["special"] else gguf.TokenType.USER_DEFINED
+        types[vocab[data["model"]["unk_token"]]] = gguf.TokenType.UNKNOWN
+        self.gguf_writer.add_tokenizer_model("surya-wordlevel")
+        self.gguf_writer.add_tokenizer_pre("gpt-2")
+        self.gguf_writer.add_token_list(tokens)
+        self.gguf_writer.add_token_types(types)
+        self.gguf_writer.add_token_merges([])
+        self.gguf_writer.add_unk_token_id(vocab["<unk>"])
+        self.gguf_writer.add_eos_token_id(vocab["<|im_end|>"])
+        self.gguf_writer.add_add_bos_token(False)
+        self.gguf_writer.add_add_eos_token(False)
+        self.gguf_writer.add_chat_template((self.dir_model / "chat_template.jinja").read_text())
+
+
 
