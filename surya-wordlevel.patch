+// Surya OCR WordLevel + Split(Regex("."), Isolated), with Fuse decoding.
+struct llm_tokenizer_surya_session : llm_tokenizer_bpe_session {
+    llm_tokenizer_surya_session(const llama_vocab & v, const llm_tokenizer_bpe & t) : llm_tokenizer_bpe_session(v, t), vocab(v) {}
+    const llama_vocab & vocab;
+    void tokenize(const std::string & text, std::vector<llama_token> & output) override {
+        for (size_t pos = 0; pos < text.size();) {
+            size_t len = std::min((size_t)unicode_len_utf8(text[pos]), text.size() - pos);
+            // Dot does not match LF: consecutive unmatched LFs are one WordLevel segment.
+            if (text[pos] == '\n') { len = 1; while (pos + len < text.size() && text[pos + len] == '\n') ++len; }
+            auto token = vocab.text_to_token(text.substr(pos, len));
+            output.push_back(token == LLAMA_TOKEN_NULL ? vocab.token_unk() : token);
+            pos += len;
+        }
+    }
+};
